import os
import libusb

Import('env', 'common', 'messaging')

# Upstream pandad is SPI-only. The Model S setup uses an external panda over
# USB, so we re-add USB comms (panda_comms.cc) and link libusb. Reference the
# vendored libusb from the commaai/dependencies "libusb" package directly so it
# satisfies the hermetic library resolver in the top-level SConstruct.
libusb_root = os.path.join(os.path.dirname(libusb.__file__), "install")
env = env.Clone()
env.Append(
  CPPPATH=[os.path.join(libusb_root, "include")],
  LIBPATH=[os.path.join(libusb_root, "lib")],
)

libs = ['usb-1.0', common, messaging, 'pthread']
panda = env.Library('panda', ['panda.cc', 'panda_comms.cc', 'spi.cc'])

env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

if GetOption('extras'):
  env.Program('tests/test_pandad_usbprotocol', ['tests/test_pandad_usbprotocol.cc'], LIBS=[panda] + libs)
